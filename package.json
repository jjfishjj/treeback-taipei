{
  "name": "treeback-taipei",
  "version": "0.1.0",
  "private": true,
  "description": "TreeBack Taipei shade equity simulation dashboard and civic fieldwork prototype",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --dir public --port 3000 --host 0.0.0.0",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "pnpm check && pnpm test && pnpm test:e2e",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "yaml": "2.9.1"
  }
}
